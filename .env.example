# Variables à définir dans Vercel (Settings → Environment Variables). Ne jamais committer de vraies valeurs.

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé « service_role » : serveur uniquement, jamais exposée au navigateur
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (Developers → API keys). Utiliser les clés de TEST (sk_test_…) pour les aperçus.
STRIPE_SECRET_KEY=
# Webhook (Developers → Webhooks → endpoint https://<site>/api/stripe/webhook,
# événements : checkout.session.completed, checkout.session.async_payment_succeeded, checkout.session.expired)
STRIPE_WEBHOOK_SECRET=

# Adresse publique du site (facultatif, sinon déduite de la requête)
NEXT_PUBLIC_SITE_URL=https://homeat-sigma.vercel.app
